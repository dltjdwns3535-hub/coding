{
  "name": "sajin-matchum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "python3 -m http.server 4173 --directory out",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm test && npm run typecheck && npm run build && npm run test:e2e && npm audit --audit-level=high",
    "package:static": "python3 scripts/package-static.py"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
